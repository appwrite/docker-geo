{
    "name": "appwrite/docker-geo",
    "type": "project",
    "require": {
        "php": ">=8.3.0",
        "utopia-php/fetch": "^0.2.1",
        "utopia-php/http": "1.0.*",
        "utopia-php/platform": "dev-feat-upgrade-http",
        "utopia-php/di": "^0.1.0",
        "utopia-php/system": "^0.10.0",
        "utopia-php/logger": "^0.7.0",
        "utopia-php/dsn": "^0.2.1",
        "utopia-php/cli": "dev-feat-upgrade-http as 0.19.0"
    },
    "autoload": {
        "psr-4": {
            "Appwrite\\Geo\\": "src/Geo"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests"
        }
    },
    "authors": [
        {
            "name": "Appwrite",
            "email": "team@appwrite.io"
        }
    ],
    "require-dev": {
        "phpunit/phpunit": "^11.3",
        "laravel/pint": "^1.18",
        "phpstan/phpstan": "^1.12"
    },
    "scripts": {
        "lint": "./vendor/bin/pint --test --config pint.json",
        "format": "./vendor/bin/pint --config pint.json",
        "check": "./vendor/bin/phpstan analyse -c phpstan.neon",
        "test:e2e": "./vendor/bin/phpunit --testsuite e2e"
    }
}
